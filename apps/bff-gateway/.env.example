# Copy to .env and fill in. The process fails fast at startup if RATING_SERVICE_URL is missing.

# quoteflow-rating-service's own origin — bff-gateway proxies every quote read/write here,
# it never talks to Postgres directly.
RATING_SERVICE_URL=http://localhost:4000

# HTTP port
PORT=4100

# Comma-separated list of allowed browser origins (customer-portal, agent-portal)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Sent as the Origin header on outgoing calls to quoteflow-rating-service — must be included
# in Repo 1's own CORS_ORIGINS (it defaults to including it already).
SELF_ORIGIN=http://localhost:4100

# Path (relative to the Nx workspace root) to the local feature-flags JSON file.
FEATURE_FLAGS_FILE=apps/bff-gateway/flags.local.json
