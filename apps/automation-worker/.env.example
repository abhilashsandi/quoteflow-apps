# Copy to .env and fill in as needed. Both RABBITMQ_URL and RATING_SERVICE_URL are required —
# the process fails fast at startup if either is missing.

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RATING_SERVICE_URL=http://localhost:4000

# Where the Playwright automation navigates to (the mock carrier portal's own origin).
MOCK_CARRIER_PORTAL_URL=http://localhost:4200
# Where the mock carrier portal's Express server listens.
MOCK_CARRIER_PORTAL_PORT=4200

# false shows the browser window — useful when watching the automation run locally.
BROWSER_HEADLESS=true

# How many times a failed bind job is retried before it's routed to the dead-letter queue.
MAX_RETRIES=3

# Fails a job before the Playwright automation even runs, forcing the retry/DLQ path
# deterministically for a demo. 0 disables it.
SIMULATED_FAILURE_RATE=0

# The mock carrier portal's own simulated failure rate on /bind-form submissions (0-1) —
# models a real carrier system being flaky, independent of SIMULATED_FAILURE_RATE above.
MOCK_PORTAL_FAILURE_RATE=0.1

# Where API-driven carriers (currently: Vantage Direct) get bound — see
# bind-job-handler.ts's API_DRIVEN_CARRIER_CODES.
MOCK_CARRIER_API_URL=http://localhost:4300
# Where the mock carrier API's Express server listens.
MOCK_CARRIER_API_PORT=4300
# Fake bearer token the worker authenticates to the mock carrier API with.
MOCK_CARRIER_API_KEY=dev-vantage-api-key
# The mock carrier API's own simulated failure rate on /v1/bind calls (0-1).
MOCK_CARRIER_API_FAILURE_RATE=0.1
